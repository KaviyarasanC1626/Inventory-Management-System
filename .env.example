FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=mysql+pymysql://ims_user:change-me@127.0.0.1:3306/inventory_management?charset=utf8mb4
LOG_LEVEL=INFO

# Only used by the opt-in demo seed command. Use a unique development password.
DEMO_ADMIN_PASSWORD=

# Set only to a disposable MySQL schema when running the optional locking test.
MYSQL_TEST_DATABASE_URL=